# StudentIQ Environment Configuration
APP_ENV=development
LOG_LEVEL=INFO

# Data Paths
RAW_DATA_PATH=data/raw/demo_schools_welfare.csv
CLEANED_DATA_PATH=data/processed/cleaned_schools_welfare.csv
DUCKDB_PATH=data/processed/analytics.duckdb
QUALITY_REPORT_PATH=data/processed/data_quality_report.json
MODEL_PATH=data/processed/dropout_risk_model.joblib

# Risk & Welfare Thresholds
ATTENDANCE_ANOMALY_LOW=40.0
ATTENDANCE_ANOMALY_HIGH=99.0
DROPOUT_HIGH_RISK_THRESHOLD=15.0
DROPOUT_CRITICAL_RISK_THRESHOLD=25.0

# Optional Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=5